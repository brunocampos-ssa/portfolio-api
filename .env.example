DATABASE_URL=postgres://postgres:postgres@localhost:5432/portfolio?sslmode=disable
PORT=8080
GRPC_PORT=50051
ETH_RPC_URL=https://eth.drpc.org/
KLEVER_API_BASE_URL=https://api.mainnet.klever.org
COINGECKO_DEMO_API_KEY=

# JWT signing key for HS256. Must be at least 32 bytes in production.
# Generate one with: openssl rand -base64 48
# If unset, the API server warns and uses an INSECURE deterministic fallback
# so `make run` works without setup. NEVER ship without setting this.
JWT_SIGNING_KEY=

# Event Watcher
WATCHER_POLL_INTERVAL=15s
WATCHER_START_BLOCK=0

# Snapshot Runner
SNAPSHOT_WORKERS=3

# Integration Tests (optional override)
# The forked-mainnet watcher test (test/integration/watcher_integration_test.go)
# defaults to forking through https://eth.drpc.org/. Override this variable
# with a dedicated RPC (Infura/Alchemy/QuickNode/...) if you hit rate limits.
TEST_ETH_FORK_URL=

# =============================================================================
# Module 4 Aula 2 — Mensageria
# =============================================================================
# Kafka is the event source-of-truth (watcher publishes here). Three
# consumer groups — persister, router, analytics — each see the full
# stream independently.
KAFKA_BROKERS=localhost:9092

# RabbitMQ is the topic-routed fan-out (router publishes filtered events
# here). The notifier binds a queue to a routing-key pattern.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# event-notifier subscription pattern. Examples:
#   *.incoming.*  — any incoming transfer (any chain, any token)
#   ethereum.#    — every ethereum event
#   *.*.usdc      — USDC events on any chain, any direction
NOTIFIER_BINDING_KEY=*.incoming.*
